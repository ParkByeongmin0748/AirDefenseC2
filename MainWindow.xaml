<Window x:Class="AirDefenseC2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AirDefenseC2.Views"
        Title="AirDefense C2 | Educational Simulator" Width="1400" Height="900"
        MinWidth="1060" MinHeight="730" Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="205"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="57*"/>
            <ColumnDefinition Width="43*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" CornerRadius="9" Padding="20,10"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="AIR DEFENSE / C2 SIMULATOR" FontWeight="Bold" FontSize="19" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="EDUCATIONAL DEMO  ·  FICTIONAL DATA ONLY" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TargetCount}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding RunState}" Foreground="#39D98A" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button Content="▶ START" Command="{Binding StartCommand}"/>
                    <Button Content="Ⅱ PAUSE" Command="{Binding PauseCommand}"/>
                    <Button Content="↻ RESET" Command="{Binding ResetCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <views:RadarView Grid.Row="1" Grid.Column="0" Margin="0,0,12,12"/>
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="57*"/>
                <RowDefinition Height="43*"/>
            </Grid.RowDefinitions>
            <views:TargetListView Grid.Row="0" Margin="0,0,0,12"/>
            <views:WeaponPanelView Grid.Row="1"/>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" CornerRadius="9" Padding="16,12" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="EVENT LOG / 시뮬레이션 기록" FontSize="14" FontWeight="Bold" Margin="0,0,0,7"/>
                <ListBox ItemsSource="{Binding Logs}" Background="#0B1725" BorderThickness="0"
                         Foreground="#C5E6F2" FontFamily="Consolas" FontSize="12" Padding="6">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#C5E6F2"/>
                            <Setter Property="Padding" Value="1,3"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
